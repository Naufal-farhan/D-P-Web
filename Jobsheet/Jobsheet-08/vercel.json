{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.6.0"
    },
    {
      "src": "public/assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/buku/(.*)",
      "dest": "/api/buku/$1"
    },
    {
      "src": "/anggota/(.*)",
      "dest": "/api/anggota/$1"
    },
    {
      "src": "/includes/(.*)",
      "dest": "/api/includes/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}