{
  "functions": {
    "Jobsheet-07/api/index.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "Jobsheet-07/api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/Jobsheet-07/api/(.*)",
      "dest": "/Jobsheet-07/api/$1"
    },
    {
      "src": "/Jobsheet-07/api",
      "dest": "/Jobsheet-07/api/index.php"
    }
  ]
}